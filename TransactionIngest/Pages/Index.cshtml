@page
@model TransactionIngest.Pages.Transactions.IndexModel

@{
    ViewData["Title"] = "Index";
}

@{
    string auditColumnStyle = Model.AuditColumnStyle; // "display:none", "display:block width=100%", etc.
}

<form method="post">
    <input type="text" id="txtFileName" name="fileName" value="hour_1_sample.json">
    <!--
    <input type="checkbox" id="chkHideAudit" name="hideAudit" value="true">
    <label for="chkHideAudit"> Show Hidden Columns</label>
    -->
    <input type="submit" value="Import" class="btn btn-primary" />
    <p>
        File names are in the format "hour_X_sample.json", where X ranges from 1 to 28.
    </p>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].SourceSystem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].TransactionId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].CardNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].LocationCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].ProductName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].TransactionTime)
            </th>
            <th class="hiddenCols" style="@auditColumnStyle">
                @Html.DisplayNameFor(model => model.Transaction[0].AuditHistory)
            </th>
            <th class="hiddenCols" style="@auditColumnStyle">
                @Html.DisplayNameFor(model => model.Transaction[0].RevisionNumber)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Transaction) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SourceSystem)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TransactionId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CardNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LocationCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Amount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TransactionTime)
            </td>
            <td class="hiddenCols" style="@auditColumnStyle">
                @Html.DisplayFor(modelItem => item.AuditHistory)
            </td>
            <td class="hiddenCols" style="@auditColumnStyle">
                @Html.DisplayFor(modelItem => item.RevisionNumber)
            </td>
            <td></td>
        </tr>
}
    </tbody>
</table>